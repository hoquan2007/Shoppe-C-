# Copy to .env for local use. Never commit real credentials.
APP_ENV=development
PORT=8080
APP_URL=http://localhost:8080
STATIC_DIR=dist
SCHEMA_PATH=database/schema.sql
SQLITE_PATH=.cache/shoppe.db
# Production requires PostgreSQL; use a Supabase connection URI with TLS.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# At least 32 random characters for the daily Vercel maintenance endpoint.
CRON_SECRET=
# One-time local seed is explicit. Must be false in production.
SEED_DEMO=false
# Import the bundled public demo catalog after an admin exists; no demo accounts are created.
DEMO_CATALOG_AUTO_IMPORT=false
DEMO_PASSWORD=
# Bootstrap an admin explicitly; password >= 12 characters. Remove after setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
